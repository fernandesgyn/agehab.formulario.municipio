<?xml version="1.0" encoding="utf-8"?>
<configuration><system.webServer>
<defaultDocument><files><clear/><add value="index.php"/></files></defaultDocument>
<security><requestFiltering><hiddenSegments>
<add segment=".git"/><add segment=".github"/><add segment="src"/><add segment="data"/>
<add segment="database"/><add segment="partials"/><add segment="storage"/><add segment="tests"/>
</hiddenSegments><fileExtensions>
<add fileExtension=".env" allowed="false"/><add fileExtension=".sql" allowed="false"/>
<add fileExtension=".md" allowed="false"/><add fileExtension=".yml" allowed="false"/>
</fileExtensions></requestFiltering></security>
</system.webServer></configuration>
