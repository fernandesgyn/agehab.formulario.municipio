@{
    string title = (string?)ViewData["Title"] ?? "Agência Goiana de Habitação - AGEHAB";
}
<!doctype html>
<html lang="pt-BR" data-bs-theme="light">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light">
    <title>@title | AGEHAB</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.10.0/dist/css/adminlte.min.css">
    <link rel="stylesheet" asp-append-version="true" href="~/css/admin.css">
    <link rel="stylesheet" asp-append-version="true" href="~/css/adminlte-overrides.css">
    <link rel="stylesheet" asp-append-version="true" href="~/css/formulario.css">
</head>
<body class="portal-public-shell bg-body-tertiary">
<div class="app-wrapper">
    <nav class="app-header navbar navbar-expand bg-body border-bottom">
        <div class="container-fluid">
            <a asp-page="/Index" class="navbar-brand d-flex align-items-center gap-3 text-decoration-none py-2">
                <img src="~/img/logo-agehab.svg" width="78" height="46" alt="AGEHAB">
                <span class="header-system-name">Agência Goiana de Habitação - AGEHAB</span>
            </a>
        </div>
    </nav>
    <main class="app-main">
        <div class="app-content-header">
            <div class="container-fluid">
                <h3 class="mb-1">@title</h3>
            </div>
        </div>
        <div class="app-content">
            <div class="container-fluid">
                @RenderBody()
            </div>
        </div>
    </main>
    <footer class="app-footer">
        <div class="container-fluid">Agência Goiana de Habitação - AGEHAB</div>
    </footer>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/admin-lte@4.10.0/dist/js/adminlte.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
