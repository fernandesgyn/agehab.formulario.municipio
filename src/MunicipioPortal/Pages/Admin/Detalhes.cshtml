@page "/administracao/resposta/{id:long}"
@model MunicipioPortal.Pages.Admin.DetalhesModel
@{ ViewData["Title"] = "Resposta municipal"; }
@if (Model.Resposta is not null)
{
 var resposta = Model.Resposta;
 <div class="row justify-content-center"><div class="col-xl-9">
  <div class="mb-3"><a asp-page="/Admin/Index" class="btn btn-outline-secondary btn-sm">
   <i class="bi bi-arrow-left"></i> Voltar</a></div>
  <section class="card mb-4">
   <div class="card-header"><h5 class="card-title mb-0">Município: @resposta.Municipio</h5></div>
   <div class="card-body text-muted">Código IBGE: @resposta.CodigoIbge • Protocolo #@resposta.Id</div>
  </section>
  @foreach (var area in QuestionarioDefinition.Areas)
  {
   <section class="card mb-4">
    <div class="card-header"><h5 class="card-title mb-0">@area.Numero. @area.Titulo</h5></div>
    <div class="card-body"><dl class="row mb-0">
    @foreach (var campo in area.Campos)
    {
     <dt class="col-sm-8">@campo.Rotulo</dt>
     <dd class="col-sm-4">@resposta.Quantidades[campo.Chave]</dd>
    }
    </dl></div>
   </section>
  }
  <section class="card mb-4">
   <div class="card-header"><h5 class="card-title mb-0">6. Programas habitacionais</h5></div>
   <div class="card-body">
    <p>@QuestionarioDefinition.DescricaoPrograma(resposta.Programa)</p>
    @if (resposta.Programa == "PROPRIO")
    {
     <div class="p-3 border rounded bg-body-tertiary" style="white-space:pre-wrap">@resposta.Detalhes</div>
    }
   </div>
  </section>
 </div></div>
}
