@page "/acesso"
@model MunicipioPortal.Pages.Admin.LoginModel
@{ ViewData["Title"] = "Acesso administrativo"; }
<div class="row justify-content-center"><div class="col-md-6 col-lg-4">
<div class="card">
 <div class="card-header"><h5 class="card-title mb-0">Área administrativa</h5></div>
 <div class="card-body">
  @if (Model.Mensagem is not null)
  {
   <div class="alert alert-danger" role="alert">@Model.Mensagem</div>
  }
  <form method="post">
   @Html.AntiForgeryToken()
   <label asp-for="Senha" class="form-label">Senha de administração</label>
   <input asp-for="Senha" class="form-control mb-3" type="password" required autocomplete="current-password">
   <button class="btn btn-success w-100" type="submit">Entrar</button>
  </form>
 </div>
</div></div></div>
