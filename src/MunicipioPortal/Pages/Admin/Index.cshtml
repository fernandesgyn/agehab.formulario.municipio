@page "/administracao"
@model MunicipioPortal.Pages.Admin.IndexModel
@{ ViewData["Title"] = "Área administrativa"; }
@if (Model.Erro is not null)
{
 <div class="alert alert-danger" role="alert">@Model.Erro</div>
}
<div class="card">
 <div class="card-header d-flex flex-wrap align-items-center gap-3">
  <h5 class="card-title mb-0">Municípios respondentes: @Model.Respostas.Count de 246</h5>
  <div class="ms-auto d-flex flex-wrap gap-2">
   <a asp-page-handler="Exportar" class="btn btn-outline-success btn-sm">
    <i class="bi bi-file-earmark-spreadsheet"></i> Exportar CSV
   </a>
   <form method="post" asp-page-handler="Sair" class="m-0">
    @Html.AntiForgeryToken()
    <button class="btn btn-outline-secondary btn-sm" type="submit">Sair</button>
   </form>
  </div>
 </div>
 <div class="card-body">
  <label for="filtro" class="form-label">Pesquisar município</label>
  <input type="search" class="form-control mb-3" id="filtro" placeholder="Digite o nome do município">
  <div class="table-responsive">
   <table class="table table-striped table-hover align-middle" id="tabela-respostas">
    <thead><tr><th>Município</th><th>Cadastro/seleção</th><th>Visitas sociais</th>
     <th>TS pré</th><th>TS pós</th><th>Programa</th><th>Enviado em</th><th>Ação</th></tr></thead>
    <tbody>
     @foreach (var r in Model.Respostas)
     {
      <tr>
       <td><strong>@r.Municipio</strong></td>
       <td>@r.Total(2)</td>
       <td>@r.Total(3)</td>
       <td>@r.Total(4)</td>
       <td>@r.Total(5)</td>
       <td>@QuestionarioDefinition.DescricaoPrograma(r.Programa)</td>
       <td>@r.CriadoEm.ToString("dd/MM/yyyy HH:mm")</td>
       <td><a asp-page="/Admin/Detalhes" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">Consultar</a></td>
      </tr>
     }
     @if (Model.Respostas.Count == 0)
     {
      <tr class="empty-row"><td colspan="8" class="text-muted">Nenhuma resposta encontrada.</td></tr>
     }
    </tbody>
   </table>
  </div>
 </div>
</div>
@section Scripts {
<script>
document.getElementById('filtro').addEventListener('input',function(){
 const busca=this.value.toLocaleLowerCase('pt-BR');
 document.querySelectorAll('#tabela-respostas tbody tr:not(.empty-row)').forEach(tr=>{
  tr.hidden=!tr.cells[0].textContent.toLocaleLowerCase('pt-BR').includes(busca);
 });
});
</script>
}
