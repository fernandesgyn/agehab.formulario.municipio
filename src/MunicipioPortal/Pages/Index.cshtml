@page "/"
@model MunicipioPortal.Pages.IndexModel
@{
    ViewData["Title"] = "Formulário para Municípios Goianos";
}
<div class="row justify-content-center">
<div class="col-xl-10 col-xxl-9">
 <div class="card mb-4"><div class="card-body form-intro d-flex flex-column flex-md-row gap-3 align-items-md-center">
  <div class="form-intro-icon"><i class="bi bi-buildings"></i></div>
  <div><h4 class="mb-1">Levantamento de equipes e programas habitacionais</h4>
  <p class="mb-0 text-muted">Informe os dados do seu município. Quando não houver profissionais em uma categoria, registre zero.</p></div>
 </div></div>

 @if (!ViewData.ModelState.IsValid)
 {
 <div class="alert alert-danger" role="alert">
  <strong>Há informações que precisam ser conferidas.</strong>
  <div asp-validation-summary="ModelOnly"></div>
 </div>
 }
 <form method="post" id="questionnaire-form" novalidate>
  @Html.AntiForgeryToken()
  <section class="card mb-4">
   <div class="card-header"><h5 class="card-title mb-0">1. Identificação do município</h5></div>
   <div class="card-body">
    <label asp-for="Dados.CodigoIbge" class="form-label fw-semibold">Nome do município <span class="text-danger">*</span></label>
    <select asp-for="Dados.CodigoIbge" class="form-select" required>
     <option value="">Selecione um município de Goiás...</option>
     @foreach (var municipio in Model.Municipios)
     {
      <option value="@municipio.CodigoIbge">@municipio.Nome</option>
     }
    </select>
    <span asp-validation-for="Dados.CodigoIbge" class="text-danger small"></span>
    <div class="form-text">Seleção entre os 246 municípios do Estado de Goiás.</div>
   </div>
  </section>

  @foreach (var area in QuestionarioDefinition.Areas)
  {
   <section class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center gap-2">
     <h5 class="card-title mb-0">@area.Numero. @area.Titulo</h5>
     <span class="badge text-bg-light border">Questão @area.Numero</span>
    </div>
    <div class="card-body">
     <p class="text-muted small">Quantidade de profissionais por vínculo.</p>
     <div class="row g-3">
      @for (var i = 0; i < area.Campos.Count; i++)
      {
       var campo = area.Campos[i];
       Model.Dados.Quantidades.TryGetValue(campo.Chave, out var valorAnterior);
       <div class="col-12 col-sm-6">
        <label for="@campo.Chave" class="form-label">@area.Numero.@(i + 1) @campo.Rotulo</label>
        <input class="form-control count-input" type="number" inputmode="numeric" min="0" max="100000" step="1"
          id="@campo.Chave" name="@($"Dados.Quantidades[{campo.Chave}]")" value="@(valorAnterior ?? "0")" data-area="@area.Numero" required>
        @Html.ValidationMessage($"Dados.Quantidades[{campo.Chave}]", "", new { @class = "text-danger small" })
       </div>
      }
     </div>
    </div>
    <div class="card-footer bg-body-tertiary d-flex justify-content-between align-items-center">
     <span class="text-muted">Total de profissionais informados neste bloco</span>
     <strong class="area-total" data-total="@area.Numero">0</strong>
    </div>
   </section>
  }

  <section class="card mb-4">
   <div class="card-header"><h5 class="card-title mb-0">6. Programas habitacionais do município</h5></div>
   <div class="card-body">
    <p class="mb-3">O município possui algum programa habitacional próprio, financiado exclusivamente com recursos municipais?</p>
    @foreach (var programa in QuestionarioDefinition.Programas)
    {
     <div class="form-check mb-3">
      <input type="radio" asp-for="Dados.Programa" class="form-check-input" id="programa_@programa.Codigo" value="@programa.Codigo" required>
      <label class="form-check-label" for="programa_@programa.Codigo">@programa.Titulo</label>
     </div>
    }
    <span asp-validation-for="Dados.Programa" class="text-danger small"></span>
    <div id="programa-detalhes-group" class="mt-3 p-3 rounded border bg-body-tertiary" hidden>
     <label asp-for="Dados.Detalhes" class="form-label fw-semibold">6.1. Nome do programa próprio e benefício concedido <span class="text-danger">*</span></label>
     <textarea asp-for="Dados.Detalhes" class="form-control" rows="4" maxlength="2000"
        placeholder="Ex.: nome do programa; concessão de lotes, casas ou ajuda de custo."></textarea>
     <span asp-validation-for="Dados.Detalhes" class="text-danger small"></span>
    </div>
   </div>
  </section>
  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 pb-4">
   <span class="small text-muted"><i class="bi bi-shield-check me-1"></i>As informações serão armazenadas no SQL Server da AGEHAB.</span>
   <button type="submit" class="btn btn-success px-4" id="send-form"><i class="bi bi-check2-circle me-1"></i>Enviar formulário</button>
  </div>
 </form>
</div></div>
@section Scripts {
 <script src="~/js/formulario.js" asp-append-version="true"></script>
}
